<UserControl x:Class="CallLedger.Desktop.Controls.EditorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
              Margin="{StaticResource FieldGap}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="False" Margin="{StaticResource FieldLabelGap}">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource FieldActionButton}"
                Content="&#xE8C8;"
                ToolTip="{Binding Label, ElementName=Root, StringFormat=Copy {0} actual value. Windows Clipboard history may retain sensitive data.}"
                AutomationProperties.Name="{Binding Label, ElementName=Root, StringFormat=Copy {0} actual value}"
                AutomationProperties.HelpText="Windows Clipboard history may retain sensitive data."
                Command="{Binding CopyCommand, ElementName=Root}"
                CommandParameter="{Binding FieldKey, ElementName=Root}" />
        <Button Style="{StaticResource FieldActionButton}"
                Content="&#xE77F;"
                ToolTip="{Binding Label, ElementName=Root, StringFormat=Paste into {0}}"
                AutomationProperties.Name="{Binding Label, ElementName=Root, StringFormat=Paste into {0}}"
                Command="{Binding PasteCommand, ElementName=Root}"
                CommandParameter="{Binding FieldKey, ElementName=Root}" />
        <Button Style="{StaticResource FieldActionButton}"
                Content="&#xE890;"
                ToolTip="{Binding Label, ElementName=Root, StringFormat=Reveal or mask {0}}"
                AutomationProperties.Name="{Binding Label, ElementName=Root, StringFormat=Reveal or mask {0}}"
                Visibility="{Binding IsSensitive, ElementName=Root, Converter={StaticResource BoolToVisibility}}"
                Command="{Binding ToggleSensitiveCommand, ElementName=Root}"
                CommandParameter="{Binding FieldKey, ElementName=Root}" />
      </StackPanel>
      <Label x:Name="FieldLabel"
             Content="{Binding Label, ElementName=Root}"
             FontSize="{StaticResource UiTextSize}"
             FontWeight="SemiBold"
             Foreground="{StaticResource MutedInkBrush}"
             Padding="0" />
    </DockPanel>
    <TextBox Grid.Row="1"
             Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             IsReadOnly="{Binding IsMasked, ElementName=Root}"
             MaxLength="{Binding MaxLength, ElementName=Root}"
             ToolTip="{Binding Label, ElementName=Root}"
             AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}">
      <TextBox.Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
          <Setter Property="AcceptsReturn" Value="False" />
          <Setter Property="TextWrapping" Value="NoWrap" />
          <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsMultiline, ElementName=Root}" Value="True">
              <Setter Property="AcceptsReturn" Value="True" />
               <Setter Property="MinHeight" Value="{StaticResource NotesMinHeight}" />
              <Setter Property="TextWrapping" Value="Wrap" />
              <Setter Property="VerticalContentAlignment" Value="Top" />
              <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBox.Style>
    </TextBox>
  </Grid>
</UserControl>
