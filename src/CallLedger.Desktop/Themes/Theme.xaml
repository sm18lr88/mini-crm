<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:CallLedger.Desktop.Presentation">
  <Color x:Key="CanvasColor">#0E1413</Color>
  <Color x:Key="SurfaceColor">#141D1B</Color>
  <Color x:Key="SurfaceMutedColor">#1B2724</Color>
  <Color x:Key="SurfaceElevatedColor">#202D29</Color>
  <Color x:Key="InkColor">#E8F2EE</Color>
  <Color x:Key="MutedInkColor">#B5C8C0</Color>
  <Color x:Key="SubtleInkColor">#849B92</Color>
  <Color x:Key="RuleColor">#3A4C46</Color>
  <Color x:Key="AccentColor">#197A59</Color>
  <Color x:Key="AccentHoverColor">#115D42</Color>
  <Color x:Key="AccentSoftColor">#1D4235</Color>
  <Color x:Key="AccentTextColor">#F4FFFB</Color>
  <Color x:Key="WarningColor">#F0C66D</Color>
  <Color x:Key="WarningSoftColor">#3B311B</Color>
  <Color x:Key="DangerColor">#FF9A92</Color>
  <Color x:Key="DangerSoftColor">#3B2526</Color>
  <Color x:Key="FocusColor">#66D9AC</Color>
  <Color x:Key="ScrollTrackColor">#0A100F</Color>
  <Color x:Key="ScrollThumbColor">#526B62</Color>

  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="MutedInkBrush" Color="{StaticResource MutedInkColor}" />
  <SolidColorBrush x:Key="SubtleInkBrush" Color="{StaticResource SubtleInkColor}" />
  <SolidColorBrush x:Key="RuleBrush" Color="{StaticResource RuleColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
  <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
  <SolidColorBrush x:Key="ScrollTrackBrush" Color="{StaticResource ScrollTrackColor}" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

  <sys:Double x:Key="TitleTextSize">24</sys:Double>
  <sys:Double x:Key="SectionTextSize">16</sys:Double>
  <sys:Double x:Key="BodyTextSize">14</sys:Double>
  <sys:Double x:Key="UiTextSize">13</sys:Double>
  <sys:Double x:Key="CaptionTextSize">12</sys:Double>
  <sys:Double x:Key="MicroTextSize">11</sys:Double>
  <sys:Double x:Key="Space1">4</sys:Double>
  <sys:Double x:Key="Space2">8</sys:Double>
  <sys:Double x:Key="Space3">12</sys:Double>
  <sys:Double x:Key="Space4">16</sys:Double>
  <sys:Double x:Key="Space6">24</sys:Double>
  <sys:Double x:Key="Space8">32</sys:Double>
  <sys:Double x:Key="FieldActionSize">28</sys:Double>
  <sys:Double x:Key="ControlHeight">32</sys:Double>
  <sys:Double x:Key="NotesMinHeight">120</sys:Double>

  <Thickness x:Key="RuleThickness">1</Thickness>
  <Thickness x:Key="InputPadding">8,4</Thickness>
  <Thickness x:Key="ButtonPadding">12,6</Thickness>
  <Thickness x:Key="RegionPadding">16</Thickness>
  <Thickness x:Key="CompactPadding">12</Thickness>
  <Thickness x:Key="InlineGap">0,0,8,0</Thickness>
  <Thickness x:Key="SectionTopGap">0,12,0,0</Thickness>
  <Thickness x:Key="EditorTopGap">0,16,0,0</Thickness>
  <Thickness x:Key="FieldGap">0,0,0,12</Thickness>
  <Thickness x:Key="EditorBottomGap">0,0,0,16</Thickness>
  <Thickness x:Key="EditorSectionMargin">0,4,0,12</Thickness>
  <Thickness x:Key="FieldLabelGap">0,0,0,4</Thickness>
  <Thickness x:Key="MicroTopGap">0,4,0,0</Thickness>
  <Thickness x:Key="RuleBottomThickness">0,0,0,1</Thickness>
  <Thickness x:Key="RuleTopThickness">0,1,0,0</Thickness>
  <Thickness x:Key="RuleRightThickness">0,0,1,0</Thickness>
  <Thickness x:Key="PillPadding">8,4</Thickness>
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">8</CornerRadius>

  <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

  <Style TargetType="{x:Type Window}">
    <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="{StaticResource BodyTextSize}" />
  </Style>

  <Style TargetType="{x:Type TextBlock}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>

  <Style TargetType="{x:Type Label}">
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>

  <Style TargetType="{x:Type TextBox}">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource InputPadding}" />
    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource RuleThickness}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource BodyTextSize}" />
    <Setter Property="CaretBrush" Value="{StaticResource InkBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="SelectionOpacity" Value="1" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
      </Trigger>
      <Trigger Property="IsReadOnly" Value="True">
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource RuleThickness}" />
    <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="FontSize" Value="{StaticResource UiTextSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource RadiusSmall}">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.48" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="QuietButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}" />
    <Setter Property="Padding" Value="{StaticResource InputPadding}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DestructiveButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
  </Style>

  <Style x:Key="FieldActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Width" Value="{StaticResource FieldActionSize}" />
    <Setter Property="Height" Value="{StaticResource FieldActionSize}" />
    <Setter Property="MinWidth" Value="{StaticResource FieldActionSize}" />
    <Setter Property="MinHeight" Value="{StaticResource FieldActionSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="{StaticResource CaptionTextSize}" />
  </Style>

  <Style TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="FontSize" Value="{StaticResource UiTextSize}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="CheckBoxBorder"
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    Background="{StaticResource SurfaceElevatedBrush}"
                    BorderBrush="{StaticResource RuleBrush}"
                    BorderThickness="{StaticResource RuleThickness}"
                    CornerRadius="{StaticResource RadiusSmall}">
              <Path x:Name="CheckMark"
                    Data="M 2 8 L 6 12 L 14 3"
                    Stroke="{StaticResource AccentTextBrush}"
                    StrokeThickness="2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Visibility="Collapsed" />
            </Border>
            <ContentPresenter Grid.Column="1"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.48" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FilterButton" TargetType="{x:Type ToggleButton}">
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource RuleThickness}" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
    <Setter Property="FontSize" Value="{StaticResource UiTextSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource RadiusSmall}">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.48" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type ComboBox}">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource InputPadding}" />
    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource RuleThickness}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton x:Name="DropDownToggle"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Focusable="False"
                          ClickMode="Press"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
              <Border x:Name="DropDownBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{StaticResource RadiusSmall}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                  <Path Grid.Column="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Data="M 0 0 L 8 0 L 4 5 Z"
                        Fill="{StaticResource MutedInkBrush}" />
                </Grid>
              </Border>
            </ToggleButton>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   PopupAnimation="Fade">
              <Border MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                      Margin="0,4,0,0"
                      Background="{StaticResource SurfaceElevatedBrush}"
                      BorderBrush="{StaticResource RuleBrush}"
                      BorderThickness="{StaticResource RuleThickness}"
                      CornerRadius="{StaticResource RadiusSmall}">
                <ScrollViewer CanContentScroll="True"
                              MaxHeight="280"
                              Padding="4">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="DropDownBorder" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.48" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Padding" Value="{StaticResource InputPadding}" />
    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border x:Name="ItemBorder"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource RadiusSmall}">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type DataGrid}">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="VerticalGridLinesBrush" Value="{StaticResource TransparentBrush}" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeaderWidth" Value="0" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <Style TargetType="{x:Type DataGridColumnHeader}">
    <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{StaticResource InputPadding}" />
    <Setter Property="FontSize" Value="{StaticResource MicroTextSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style TargetType="{x:Type DataGridCell}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{StaticResource InputPadding}" />
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type DataGridRow}">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{StaticResource ScrollTrackBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type Thumb}">
    <Setter Property="Background" Value="{StaticResource ScrollThumbBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border x:Name="ThumbBorder"
                  Margin="2"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource RadiusSmall}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource FocusBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
    <Border Background="{TemplateBinding Background}"
            CornerRadius="{StaticResource RadiusSmall}">
      <Track x:Name="PART_Track"
             IsDirectionReversed="True"
             Focusable="False">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                        Command="{x:Static ScrollBar.PageUpCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                        Command="{x:Static ScrollBar.PageDownCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
        </Track.IncreaseRepeatButton>
      </Track>
    </Border>
  </ControlTemplate>

  <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
    <Border Background="{TemplateBinding Background}"
            CornerRadius="{StaticResource RadiusSmall}">
      <Track x:Name="PART_Track"
             Focusable="False">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                        Command="{x:Static ScrollBar.PageLeftCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                        Command="{x:Static ScrollBar.PageRightCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
        </Track.IncreaseRepeatButton>
      </Track>
    </Border>
  </ControlTemplate>

  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="10" />
    <Setter Property="Background" Value="{StaticResource ScrollTrackBrush}" />
    <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="StatusPill" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource RuleThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="Padding" Value="{StaticResource PillPadding}" />
  </Style>

  <Style TargetType="{x:Type Separator}">
    <Setter Property="Background" Value="{StaticResource RuleBrush}" />
    <Setter Property="Margin" Value="0,8" />
  </Style>
</ResourceDictionary>
