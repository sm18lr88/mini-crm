<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'CallLedger.Desktop' or '$(MSBuildProjectName)' == 'CallLedger.Cli'">
    <Content Include="$(MSBuildThisFileDirectory)README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)CLI.md" Link="CLI.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)docs/VERIFICATION.md" Link="docs/VERIFICATION.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildSDKsPath)/../../../LICENSE.txt" Link="DOTNET-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildSDKsPath)/../../../ThirdPartyNotices.txt" Link="DOTNET-THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
